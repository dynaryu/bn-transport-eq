{
  "$schema": "../meta/function.schema.json",
  "id": "fragility.lognormal",
  "label": "Lognormal bridge fragility",
  "version": "0.2.0",
  "role": "fragility",
  "per": "Bridge",
  "inputs": [
    {
      "name": "im",
      "quantity": "{imt}",
      "over": "Bridge",
      "via": "self",
      "description": "The IM these curves are defined on, at this bridge."
    }
  ],
  "outputs": [
    {
      "name": "damage",
      "quantity": "DamageState.HazusBridge"
    }
  ],
  "parameters": {
    "description": "P(DS >= k | im) = Phi(ln(im / median_k) / beta), medians in the IM's own unit. One shared beta and non-decreasing medians, so the curves cannot cross.",
    "type": "object",
    "required": [
      "imt",
      "medians",
      "beta"
    ],
    "additionalProperties": false,
    "properties": {
      "imt": {
        "description": "The intensity measure the curves are defined on.",
        "enum": [
          "PGA",
          "PGV",
          "SA(0.3)",
          "SA(1.0)",
          "SA(3.0)"
        ]
      },
      "medians": {
        "type": "object",
        "required": [
          "slight",
          "moderate",
          "extensive",
          "complete"
        ],
        "additionalProperties": false,
        "properties": {
          "slight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "moderate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "extensive": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "complete": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "beta": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    }
  },
  "implementation": "src.builder.kernels.fragility:LognormalFragility",
  "deterministic": false,
  "drawKind": "Marginal",
  "capabilities": [
    "SampleForward",
    "EvaluateDensity"
  ],
  "description": "Base (unmodified) curves on whichever IM the parameter set names: a set on PGA wires only to a hazard that produces PGA, and the check says so if none does. Skew, span-count or shape modifiers would be Bridge attributes under `attributes`."
}
