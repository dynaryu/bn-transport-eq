{
  "$schema": "../meta/function.schema.json",
  "id": "system.max-flow",
  "label": "Maximum flow over open links, and whether it meets its threshold",
  "version": "0.2.0",
  "role": "system",
  "per": "SystemEvent",
  "inputs": [
    {
      "name": "open",
      "quantity": "LinkOpen",
      "over": "Edge",
      "via": "*"
    }
  ],
  "outputs": [
    {
      "name": "max_flow",
      "quantity": "MaxFlow"
    },
    {
      "name": "state",
      "quantity": "SystemState",
      "description": "1 if max flow >= min_flow, else 0."
    }
  ],
  "attributes": [
    "origin",
    "destination",
    "min_flow"
  ],
  "tables": [
    "Node",
    "Edge"
  ],
  "implementation": "src.builder.kernels.system:MaxFlow",
  "deterministic": true,
  "drawKind": "Joint",
  "capabilities": [
    "SampleForward"
  ],
  "description": "Origin-to-destination max flow, with Edge.capacity on each open link and 0 on a closed one; the event survives if it reaches min_flow. Parallel links add their capacities; an undirected link carries its capacity in each direction."
}
