{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "Network",
  "description": "One transport network's rows, one table per entity type. Row shape is checked against the entity types in code, because the columns are defined there rather than here.",
  "type": "object",
  "required": ["network", "title", "source", "assumptions", "tables"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "network": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "source": {"type": "object"},
    "assumptions": {
      "description": "Every value in the tables that was assumed rather than observed, named here.",
      "type": "object", "additionalProperties": {"type": "string"}
    },
    "tables": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Za-z]*$"},
      "additionalProperties": {
        "type": "array",
        "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}
      }
    }
  }
}
