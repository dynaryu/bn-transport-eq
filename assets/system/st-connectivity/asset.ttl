@prefix cap:  <https://example.org/dra/cap#> .
@prefix ex:   <https://example.org/dra/assets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:st-connectivity a cap:Asset ;
    rdfs:label "s-t connectivity system simulator"@en ;
    cap:assetId       "system/st-connectivity" ;
    cap:version       "0.1.0" ;
    cap:implementedBy "model.py:StConnectivity" ;

    cap:targetVariable "Service" ;
    cap:givenVariable  "AssetFunctionality" ;

    # Deterministic: given link states the graph either connects s to t or it does not.
    cap:deterministic true ;
    cap:support       cap:Discrete ;
    cap:units         "binary: 1 connected, 0 severed" ;
    cap:drawKind      cap:Joint ;
    cap:batchable     true ;
    cap:costPerEval   "1e-5 s per sample at |E| ~ 1e2" ;
    cap:reproducible  true ;

    cap:hasCapability cap:SampleForward ,
                      cap:EvaluateDensity ,
                      cap:EvaluateLikelihood ,
                      cap:BatchClassify ;

    cap:validityScope "Undirected graphs. Binary link states only: a link is either usable or not. Partial capacity is out of scope -- use system/max-flow for that." .
