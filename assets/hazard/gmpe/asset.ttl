@prefix cap:  <https://example.org/dra/cap#> .
@prefix ex:   <https://example.org/dra/assets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:gmpe a cap:Asset ;
    rdfs:label "Ground-motion prediction equation (lognormal kernel)"@en ;
    cap:assetId       "hazard/gmpe" ;
    cap:version       "0.1.0" ;
    cap:implementedBy "model.py:Gmpe" ;

    cap:targetVariable "LocalIntensity" ;
    cap:givenVariable  "HazardEvent" ;

    # ln Y = mu(rupture, distance, site) + eps, eps ~ N(0, sigma). Not degenerate:
    # the aleatory term is most of the hazard, so sigma must never be dropped.
    cap:deterministic false ;
    cap:support       cap:Continuous ;
    cap:units         "g for PGA/SA/PSA, cm/s for PSV, cm for SD at the API boundary; each model's own internal units and log base are preserved and recorded in provenance" ;

    # MARGINAL, and this is the asset's most consequential limitation. A GMPE gives
    # the distribution at ONE site. None of the 30 benchmark families carries a
    # spatial correlation model, so draws at different sites are independent here.
    # That understates the chance of many assets being hit hard at once, which is
    # exactly the tail a network risk calculation turns on. A joint LocalIntensity
    # needs a correlation model (Jayaram-Baker or similar) as a separate asset.
    cap:drawKind      cap:Marginal ;

    cap:batchable     true ;
    cap:costPerEval   "1e-6 s per site-period (closed form)" ;
    cap:reproducible  true ;

    cap:hasCapability cap:SampleForward ,
                      cap:EvaluateDensity ,
                      cap:EvaluateLikelihood ;

    # NormalisingConstant is not declared: the lognormal is normalised over Y by
    # construction, so Z = 1 is trivial and useless. The Z an evidence calculation
    # actually needs is over the upstream hazard distribution, which this asset does
    # not hold. BatchClassify and Gradient are not declared because the target is
    # continuous and the kernel is not differentiated here.

    cap:validityScope "Single-site intensity only; no spatial correlation, so never use it to draw a correlated field across multiple assets. Each model family is valid only inside its own published magnitude, distance, period and damping envelope, recorded in params/registry.json; outside it the wrapper refuses unless the caller sets allow_extrapolation. NO published model is usable at version 0.1.0: no authoritative coefficient table for any of the 30 families is present in this repository, so constructing one raises CoefficientsUnavailable. The default _verification model is a SYNTHETIC framework test fixture with invented coefficients and must never be used for hazard assessment." .
