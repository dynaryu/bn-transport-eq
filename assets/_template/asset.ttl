@prefix cap:  <https://example.org/dra/cap#> .
@prefix ex:   <https://example.org/dra/assets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Copy this folder, rename it, and fill every field.
# Declare ONLY capabilities the wrapper actually implements and that run when
# called -- the conformance harness calls each one. An overclaimed capability
# makes the compiler pick an operator that cannot run, and that surfaces as a
# wrong posterior rather than an error.

ex:«asset-name» a cap:Asset ;
    rdfs:label "«human readable name»"@en ;
    cap:assetId       "«category/asset-name»" ;
    cap:version       "0.1.0" ;
    cap:implementedBy "model.py:«ClassName»" ;   # relative to this folder

    cap:targetVariable "«Variable this supplies»" ;
    cap:givenVariable  "«parent»" , "«parent»" ;

    cap:deterministic «true|false» ;
    cap:support       cap:«Discrete|Continuous|Mixed» ;
    cap:units         "«units of the target»" ;
    cap:drawKind      cap:«Joint|Marginal» ;     # Marginal silently imposes independence
    cap:batchable     «true|false» ;
    cap:costPerEval   "«order of magnitude, e.g. 1e-4 s»" ;
    cap:reproducible  «true|false» ;

    cap:hasCapability cap:«SampleForward» ;      # add only what is implemented

    cap:validityScope "«conditions under which this asset may legitimately be used»" .
