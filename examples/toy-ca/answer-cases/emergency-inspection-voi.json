            {
              "name": "defer",
              "losses": {
                "0": 100,
                "1": 0
              }
            }
          ],
          "inspections": [
            {
              "node": "Usable::b2",
              "cost": 2,
              "accuracy": [
                [
                  1,
                  0
                ],
                [
                  0,
                  1
                ]
              ]
            }
          ]
        }
      }
    ]
  },
  "must_not": [
    "Treat an inspection as repair",
