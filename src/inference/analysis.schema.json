{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["kind", "query"], "additionalProperties": false,
  "properties": {
    "kind": {"enum": ["compare", "importance", "paths", "voi"]},
    "query": {"type": "object"},
    "variants": {"type": "array", "minItems": 1, "maxItems": 20, "items": {
      "type": "object", "required": ["name", "changes"], "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "changes": {"type": "object"}}
    }},
    "bridges": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}},
    "topology_only": {"type": "boolean"},
    "origin": {"type": "string"}, "destination": {"type": "string"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 20},
    "state_nodes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "loss_units": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "minItems": 2, "maxItems": 20, "items": {
      "type": "object", "required": ["name", "losses"], "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "losses": {"type": "object", "additionalProperties": {"type": "number"}}}
    }},
    "inspections": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
      "type": "object", "required": ["node", "cost", "accuracy"], "additionalProperties": false,
      "properties": {"node": {"type": "string"}, "cost": {"type": "number", "minimum": 0},
        "accuracy": {"description": "Rows are true states 0,1; columns are reported states 0,1.", "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}
    }}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "compare"}}}, "then": {"required": ["variants"]}},
    {"if": {"properties": {"kind": {"const": "importance"}}}, "then": {"required": ["bridges"]}},
    {"if": {"properties": {"kind": {"const": "paths"}}}, "then": {"required": ["origin", "destination"]}},
    {"if": {"properties": {"kind": {"const": "voi"}}}, "then": {"required": ["state_nodes", "actions", "inspections", "loss_units"]}}
  ]
}
